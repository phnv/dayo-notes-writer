# LLM Provider API Keys (mcp-agent reads these via pydantic-settings)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Agent Configuration
# DAYO_LLM_PROVIDER=openai     # Default provider: openai or gemini
# UV_PATH=/home/user/.local/bin/uv  # Path to uv binary (default: /home/phen/.local/bin/uv)
# NOTE_WRITER_PROJECT_ROOT=/path/to/project  # Project root override (auto-detected if unset)

# Application Settings
LOG_LEVEL=INFO
